# ─────────────────────────────────────────────────────────────────
# Dockerfile.api — API de la nueva interfaz (FastAPI)
# Contexto de build: raíz del repo. En Railway: RAILWAY_DOCKERFILE_PATH=Dockerfile.api
# ─────────────────────────────────────────────────────────────────
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 TZ=America/Bogota

RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev gcc tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Mismas dependencias que la app actual + FastAPI/uvicorn
COPY requirements.txt ./requirements.txt
COPY api/requirements.txt ./requirements-api.txt
RUN pip install --upgrade pip && pip install -r requirements.txt -r requirements-api.txt

COPY . .
RUN useradd --create-home app && mkdir -p data/logs && chown -R app /app
USER app

EXPOSE 8000
# Railway asigna PORT. "::" escucha también en IPv6, que usa la red privada de Railway.
CMD ["sh", "-c", "exec uvicorn api.main:app --host :: --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*' --no-server-header"]
